# Copy to .env. Demo works without credentials or model downloads.
TELCOAI_RETRIEVAL_STRATEGY=keyword
TELCOAI_STORAGE_BACKEND=memory
TELCOAI_TENANT_ID=demotel
TELCOAI_LOCALE=tr-TR
TELCOAI_SESSION_TTL_SECONDS=1800
TELCOAI_CACHE_TTL_SECONDS=300
TELCOAI_SEMANTIC_CACHE_ENABLED=false
TELCOAI_SEMANTIC_CACHE_THRESHOLD=0.97
TELCOAI_QDRANT_URL=http://localhost:6333
TELCOAI_QDRANT_COLLECTION=telcoai_faq
TELCOAI_REDIS_URL=redis://localhost:6379/0
TELCOAI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TELCOAI_SEMANTIC_MIN_SIMILARITY=0.42
TELCOAI_RERANKER_ENABLED=false
TELCOAI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TELCOAI_GENERATION_BACKEND=extractive
# Optional OpenAI-compatible local or remote structured-output provider
TELCOAI_LLM_BASE_URL=http://localhost:11434/v1
TELCOAI_LLM_MODEL=qwen3:8b
TELCOAI_LLM_API_KEY=local-demo
TELCOAI_GUARDRAILS_ENABLED=false
TELCOAI_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
# Optional token protects all /api/v1 routes. Web UI supports the bearer token.
# TELCOAI_API_KEY=
# TELCOAI_QDRANT_API_KEY=
TELCOAI_GRPC_HOST=127.0.0.1
TELCOAI_GRPC_PORT=50051
